# ==========================
# Segurança / Auth
# ==========================
# Chave usada para assinar os tokens JWT. Troque por um valor aleatório forte.
SECRET_KEY=troque_por_um_segredo_forte_e_unico

# Origens liberadas no CORS (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Se "true", popula o banco com usuários e vagas de demonstração na primeira
# inicialização (veja as credenciais no README).
RUN_SEED=true

# ==========================
# Banco de dados
# ==========================
# Deixe em branco para usar SQLite local (./data/sva.db) - zero configuração.
# Para produção com PostgreSQL, descomente e ajuste:
# DATABASE_URL=postgresql+psycopg2://sva_user:sva_password@localhost:5432/sva_db

# ==========================
# Upload de currículos
# ==========================
MAX_UPLOAD_SIZE_MB=5
ALLOWED_RESUME_EXTENSIONS=.pdf,.docx,.doc

# ==========================
# Rate limiting
# ==========================
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute

# ==========================
# Notificações por e-mail
# ==========================
# Se SMTP_HOST ficar vazio, os e-mails são apenas logados no console (modo dev).
NOTIFICATIONS_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@sva-platform.local
